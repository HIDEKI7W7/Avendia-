# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - AVENDIA 3.0 (VPS BACKEND)
# ==============================================================================
# Copia este archivo a .env en el VPS antes de levantar los contenedores:
# cp .env.production.example .env

# --- Entorno de ejecución ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Base de datos PostgreSQL ---
POSTGRES_DB=avendia
POSTGRES_USER=avendia
POSTGRES_PASSWORD=CambiaEstaContrasenaSegura2026!
DATABASE_SCHEMA=avendia3
DATABASE_SSL_REQUIRED=false

# --- Seguridad y JWT (Mínimo 32 caracteres) ---
# Genera una clave aleatoria en Linux con: openssl rand -hex 32
JWT_SECRET_KEY=clave_secreta_super_segura_de_produccion_avendia_2026_xyz
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Orígenes permitidos (CORS) ---
# Debe coincidir exactamente con la URL de tu frontend en Vercel
# IMPORTANTE: NO uses '*', la autenticación con credenciales requiere orígenes exactos
ALLOWED_ORIGINS=https://avendia-web.vercel.app,http://localhost:5173
PRODUCTION_FRONTEND_ORIGIN=https://avendia-web.vercel.app

# --- Inteligencia Artificial (Google Gemini) ---
# Requerido para la generación de evaluaciones, rúbricas y material pedagógico
GEMINI_API_KEY=AIzaSy_REEMPLAZA_CON_TU_CLAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60.0

# --- Búsqueda de imágenes en presentaciones (Opcional) ---
PRESENTATION_IMAGE_PROVIDER=auto
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# --- Administrador inicial del sistema ---
# Se creará automáticamente al iniciar el backend por primera vez
ADMIN_EMAIL=admin@avendia.com
ADMIN_PASSWORD=Avendia2026!
ADMIN_FULL_NAME=Administrador Avendia

# --- Restablecimiento de contraseñas y correos (SMTP opcional) ---
EXPOSE_PASSWORD_RESET_CODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=soporte@avendia.com
# SMTP_PASSWORD=tu_app_password
# SMTP_FROM_EMAIL=soporte@avendia.com
# SMTP_FROM_NAME=Avendia Soporte
# SMTP_USE_TLS=true
